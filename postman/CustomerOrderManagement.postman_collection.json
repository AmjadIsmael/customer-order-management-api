{
  "info": {
    "name": "Customer Order Management API",
    "description": "Covers every endpoint of the Customer Order Management API: authentication (login/register), customers, products, and orders (including line items, search and the customer order summary). Requests are wired with test scripts so running Login (or Register), then Create Customer, Create Product and Create Order in order auto-fills the {{accessToken}}, {{customerId}}, {{productId}}, {{orderId}} and {{orderItemId}} variables used by the rest of the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7044", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "customerId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "orderItemId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates as the seeded Admin account (see the README's Development seed users) and stores the returned token in {{accessToken}} for every other request in this collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (self-service customer)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"jane.doe\",\n  \"password\": \"Password1\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phoneNumber\": \"555-0100\",\n  \"address\": \"123 Main St\",\n  \"age\": 29,\n  \"gender\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Self-registers a new customer: creates a linked Customer profile and User account (Customer role), and returns a bearer token as if you'd just logged in. Running this overwrites {{accessToken}} with the new customer's token; re-run Login to switch back to Admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers"]
            },
            "description": "Staff (Admin/User) only — 403 if called with a Customer-role token."
          }
        },
        {
          "name": "Get Customer By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "{{customerId}}"]
            },
            "description": "A Customer-role token may only fetch its own linked record."
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.lovelace@example.com\",\n  \"phoneNumber\": \"555-0101\",\n  \"address\": \"1 Analytical Engine Way\",\n  \"age\": 36,\n  \"gender\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers"]
            },
            "description": "Requires the Admin role. Stores the new customer's id in {{customerId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('customerId', json.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.lovelace@example.com\",\n  \"phoneNumber\": \"555-0199\",\n  \"address\": \"1 Analytical Engine Way, Suite 2\",\n  \"age\": 37,\n  \"gender\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "{{customerId}}"]
            },
            "description": "Requires Admin, or a Customer-role token updating its own linked record."
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "customers", "{{customerId}}"]
            },
            "description": "Requires the Admin role. Soft-deletes the customer."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            }
          }
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard\",\n  \"description\": \"Hot-swappable, tactile switches\",\n  \"price\": 89.99,\n  \"stockQuantity\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            },
            "description": "Requires the Admin role. Stores the new product's id in {{productId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('productId', json.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mechanical Keyboard v2\",\n  \"description\": \"Hot-swappable, tactile switches, RGB\",\n  \"price\": 99.99,\n  \"stockQuantity\": 40\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Requires the Admin role."
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "description": "Requires the Admin role. Soft-deletes the product."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "A Customer-role token only gets its own orders back."
          }
        },
        {
          "name": "Get Order By Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Search Orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/search?customerId={{customerId}}&status=&fromDate=&toDate=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "search"],
              "query": [
                { "key": "customerId", "value": "{{customerId}}" },
                { "key": "status", "value": "", "description": "0=Pending, 1=Confirmed, 2=Shipped, 3=Delivered, 4=Cancelled" },
                { "key": "fromDate", "value": "" },
                { "key": "toDate", "value": "" }
              ]
            },
            "description": "Any unset filter is ignored. Backed by the SearchOrders stored procedure. A Customer-role token is always scoped to its own orders regardless of the customerId passed here."
          }
        },
        {
          "name": "Get Customer Order Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/customers/{{customerId}}/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "customers", "{{customerId}}", "summary"]
            },
            "description": "Backed by the GetCustomerOrderSummary stored procedure."
          }
        },
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"shippingAddress\": \"1 Analytical Engine Way\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Requires the Admin role. Decrements stock for every item. Stores the new order's id in {{orderId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "    pm.collectionVariables.set('orderId', json.id);",
                  "}",
                  "if (Array.isArray(json.items) && json.items.length > 0) {",
                  "    pm.collectionVariables.set('orderItemId', json.items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Order (status / shipping address)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 1,\n  \"shippingAddress\": \"1 Analytical Engine Way, Suite 2\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            },
            "description": "Requires the Admin role. status: 0=Pending, 1=Confirmed, 2=Shipped, 3=Delivered, 4=Cancelled. Setting it to Cancelled restores stock for every line item."
          }
        },
        {
          "name": "Add Order Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "items"]
            },
            "description": "Requires the Admin role. Decrements stock for the product; the order must not be cancelled."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json.items) && json.items.length > 0) {",
                  "    pm.collectionVariables.set('orderItemId', json.items[json.items.length - 1].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove Order Item",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/items/{{orderItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "items", "{{orderItemId}}"]
            },
            "description": "Requires the Admin role. Restores stock for the removed item's product; the order must not be cancelled."
          }
        },
        {
          "name": "Delete Order",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            },
            "description": "Requires the Admin role. Soft-deletes the order and restores stock unless it was already cancelled."
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Anonymous. Reports Healthy/Unhealthy based on whether the application and PostgreSQL are reachable."
          }
        }
      ]
    }
  ]
}
